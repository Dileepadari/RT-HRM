HR_DB_HOST=localhost
HR_DB_NAME=heart_rate_db
HR_DB_USER=root
HR_DB_PASS=
# Shared with the Android app, and also the dashboard sign-in password.
HR_API_KEY=your-secret-api-key
HR_ALLOWED_DEVICES=AA:BB:CC:DD:EE:FF

# Set to 1 to let anyone read the heart rate endpoints and the dashboard with
# no credential, which is how this server behaved before. Leave it unset: the
# read endpoints serve live and historical health data about one identifiable
# person, and nine of them used to answer anyone who knew the URL.

# Firebase Cloud Messaging (Push Notification)
HR_FCM_PROJECT_ID=1:826982365970:web:c5a61f1b78a323aaa011cb
HR_FCM_SERVICE_ACCOUNT=/path/to/firebase-service-account.json
